# Copy this to .env for local development. NEVER commit .env.

# --- Database (Supabase Postgres or local Docker) ---
DB_URL=jdbc:postgresql://localhost:5432/iris
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT signing secret ---
# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-bytes

# --- Google Sign-In ---
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- CORS ---
# Comma-separated list of origins for the mobile app dev servers and future web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
